{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "gem5": {
      "command": "python3",
      "args": ["tools/mcp/gem5_mcp/server.py"],
      "timeout": 3600000
    }
  }
}
